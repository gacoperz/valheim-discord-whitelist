# Shared by both Caddyfiles: security headers and a log that never contains the one-time OAuth code/state.
header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	-Server
}
log {
	output stdout
	format filter {
		request>uri query {
			replace code REDACTED
			replace state REDACTED
		}
	}
}
