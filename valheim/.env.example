# Settings for the game server. install.sh writes this file as VALHEIM_DIR/.env with mode 600.
SERVER_NAME=My Valheim Server
WORLD_NAME=MyWorld
# Leave empty to rely on the whitelist alone. If set: at least 5 characters, and not part of SERVER_NAME.
SERVER_PASS=
SERVER_PUBLIC=false
SERVER_ARGS=-preset normal
VALHEIM_UID=999
VALHEIM_GID=982
TZ=UTC
# Memory cap for the game container; Valheim wants 2-4 GB.
VALHEIM_MEM_LIMIT=3200m
