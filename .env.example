# Settings for the bot and Caddy (not secret). install.sh writes this file as .env;
# docs/CONFIGURATION.md explains each one. Secrets go in secrets.env, never here.

# --- Docker Compose ---
COMPOSE_PROFILES=https                  # start Caddy too; leave empty for a dev instance (docs/DEVELOPMENT.md)
BOT_CONTAINER=valheim-bot
CADDY_CONTAINER=valheim-bot-caddy
WEB_NETWORK=valheim-bot-web

# --- The game server (see valheim/compose.yaml) ---
VALHEIM_DIR=/opt/valheim                # folder with the game server's compose file and config/
WORLD_NAME=MyWorld                      # as in the game server's WORLD_NAME
VALHEIM_HOST=valheim                    # the game server's container name
VALHEIM_NETWORK=valheim_default         # the game server's compose network
VALHEIM_GID=982                         # group of the game server's files (install.sh finds it)
# WHITELIST_HOST_FILE=/opt/valheim/config/permittedlist.txt   # default; a dev instance MUST use a dummy file

# --- What players see ---
SERVER_NAME=My Valheim Server
JOIN_ADDRESS=203.0.113.7:2456           # shown in the join steps: your IP or domain, game port
MAX_PLAYERS=10
TZ=UTC                                  # e.g. Europe/Berlin; used for times in logs

# --- HTTPS for Discord's login return page ---
SITE_ADDRESS=bot.example.org            # your domain, or your public IP
CADDYFILE=./caddy/Caddyfile.domain      # ./caddy/Caddyfile.ip when SITE_ADDRESS is an IP
PUBLIC_URL=https://bot.example.org      # https://<SITE_ADDRESS>; the redirect URI is PUBLIC_URL/discord/callback

# --- Discord ---
ALLOWED_GUILDS=000000000000000000       # Discord server IDs the bot serves (space-separated); refused elsewhere
PROTECTED_STEAMIDS=                     # SteamID64s always on the whitelist, e.g. the owner (space-separated)
NOTIFY_USER_ID=                         # Discord user ID that gets admin alert DMs (empty = no DMs)
